<?xml version="1.0" encoding="utf-8"?>
<!--
    Part D: MainActivity layout for LANDSCAPE orientation.

    This file is a copy of the portrait activity_main.xml with only the lower
    half changed: instead of a 2 x 2 grid the four image buttons now sit next
    to each other in a single row, exactly as shown in Figure 4.

    Structure
    =========
    ConstraintLayout (root)
      |-  FrameLayout      "bannerContainer"  (50% of the screen height)
      |     |-  ImageView  img_main_banner
      |     +-  TextView    bannerTitle       (40sp, centred over the image)
      |
      +-  LinearLayout    "buttonPanel"      (fills the remaining 50%)
            +-  LinearLayout (weight 1) -> Facilities
            +-  LinearLayout (weight 1) -> Events
            +-  LinearLayout (weight 1) -> Clubs
            +-  LinearLayout (weight 1) -> Support

    Every size is expressed with dp / sp / weight / percentages, so the layout
    is fully responsive: it re-flows correctly on any screen size and no size
    is hard-coded.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ================= Banner (top half) ================= -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The banner artwork supplied with the assignment. -->
        <ImageView
            android:id="@+id/imgBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <!-- The banner title. 40sp is the one size the assignment allows. -->
        <TextView
            android:id="@+id/txtBannerTitle"
            style="@style/BannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/spacing_medium"
            android:text="@string/banner_title" />
    </FrameLayout>

    <!-- ================= Green button panel (bottom half) ================= -->
    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/green"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerContainer">

        <!-- Facilities -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnFacilities"
                android:layout_width="@dimen/button_icon_size"
                android:layout_height="@dimen/button_icon_size"
                android:background="@null"
                android:contentDescription="@string/cd_facilities"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                style="@style/ButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_facilities" />
        </LinearLayout>

        <!-- Events -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEvents"
                android:layout_width="@dimen/button_icon_size"
                android:layout_height="@dimen/button_icon_size"
                android:background="@null"
                android:contentDescription="@string/cd_events"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_events" />

            <TextView
                style="@style/ButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_events" />
        </LinearLayout>

        <!-- Clubs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnClubs"
                android:layout_width="@dimen/button_icon_size"
                android:layout_height="@dimen/button_icon_size"
                android:background="@null"
                android:contentDescription="@string/cd_clubs"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_clubs" />

            <TextView
                style="@style/ButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_clubs" />
        </LinearLayout>

        <!-- Support -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnSupport"
                android:layout_width="@dimen/button_icon_size"
                android:layout_height="@dimen/button_icon_size"
                android:background="@null"
                android:contentDescription="@string/cd_support"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_support" />

            <TextView
                style="@style/ButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_support" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
